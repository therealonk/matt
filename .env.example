# Copy this file to .env.local and fill it in.
# .env.local is git-ignored — never commit real credentials.

# ---------------------------------------------------------------------
# Dropbox — where all the photos live
# ---------------------------------------------------------------------
# Create a Scoped app with "App folder" access at
# https://www.dropbox.com/developers/apps, enable the permissions
# files.metadata.read and files.content.read, then run:
#
#   npm run dropbox:auth
#
# which walks through authorization and writes these three values here.
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_REFRESH_TOKEN=

# Folder inside the app folder that holds one sub-folder per shoot.
# Paths are relative to /Apps/<app name>/, so "/Shoots" means
# /Apps/MK8/Shoots in the customer's Dropbox. Default: /Shoots
DROPBOX_SHOOTS_PATH=

# ---------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------
# Enables GET /api/shoots/audit in production (it lists file names, so it
# needs a secret). Call it with ?token=… or a Bearer header.
SHOOTS_AUDIT_TOKEN=

# ---------------------------------------------------------------------
# Contact form (src/app/api/contact/route.ts)
# ---------------------------------------------------------------------
# Resend API key — https://resend.com. Without it, `npm run dev` logs
# submissions to the console instead of sending, and a production build
# tells visitors to email directly rather than pretending to send.
RESEND_API_KEY=

# Inbox that receives inquiries. Defaults to SITE.contact.email.
CONTACT_TO=

# Verified sender. Until a domain is verified in Resend, their sandbox
# address works for testing: "MK8 Media <onboarding@resend.dev>"
# (sandbox mode can only deliver to the account owner's address).
CONTACT_FROM=

# Set to "true" to log submissions instead of sending them anywhere.
CONTACT_DRY_RUN=
