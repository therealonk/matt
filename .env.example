# Contact form delivery (src/app/api/contact/route.ts)
#
# Copy this file to .env.local and fill it in. .env.local is git-ignored —
# never commit real keys.

# Resend API key — https://resend.com (free tier covers a studio's volume).
# Without it: `npm run dev` dry-runs the form and logs submissions to the
# server console; a production build returns a "not connected" message.
RESEND_API_KEY=

# Inbox that receives inquiries. Defaults to SITE.contact.email.
CONTACT_TO=

# Verified sender. Until a domain is verified in Resend, their shared
# sandbox address works for testing: "MK8 Media <onboarding@resend.dev>"
# (sandbox mode can only deliver to the account owner's address).
CONTACT_FROM=

# Set to "true" to log submissions instead of sending them, even in
# production — useful for a demo with no mail configured.
CONTACT_DRY_RUN=
